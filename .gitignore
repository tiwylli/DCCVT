# PoNQ is a vendored research repo in this workspace. Ignore the bulk of it
# while keeping the small local experiment code/configs needed to reproduce
# the PoNQ ABC and HotSpot baseline work.
PoNQ-main/*

!PoNQ-main/configs/
PoNQ-main/configs/*
!PoNQ-main/configs/eval_cnn_retrained.yaml
!PoNQ-main/configs/eval_cnn_official_abc.yaml
!PoNQ-main/configs/eval_hotspot_ponq_retrained.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_smoke.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_1.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_2.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_3.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_1_bs32_resume.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_2_bs32.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_3_bs32.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_1_bs48_resume.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_2_bs48.yaml
!PoNQ-main/configs/local_abc_cnn_multiple_quadrics_split_3_bs48.yaml

!PoNQ-main/src/
PoNQ-main/src/*
!PoNQ-main/src/eval/
PoNQ-main/src/eval/*
!PoNQ-main/src/eval/eval_ABC.py
!PoNQ-main/src/eval/eval_HOTSPOT.py
!PoNQ-main/src/eval/abc_eval_last20.txt
!PoNQ-main/src/eval/hotspot_thingi32_g33_ids.txt
!PoNQ-main/src/eval/hotspot_thingi32_g33_smoke.txt
!PoNQ-main/src/eval/results/
PoNQ-main/src/eval/results/*
!PoNQ-main/src/eval/results/results_HotSpot_pretrained_PoNQ_ABC_retrained_32_hotspot_summary.csv

!PoNQ-main/src/utils/
PoNQ-main/src/utils/*
!PoNQ-main/src/utils/abc_watertight_train_smoke.txt
!PoNQ-main/src/utils/generate_mesh_hotspot_ponq.py
!PoNQ-main/src/utils/data_processing/
PoNQ-main/src/utils/data_processing/*
!PoNQ-main/src/utils/data_processing/get_data.py
!PoNQ-main/src/utils/data_processing/normalize_abc_obj_subset.py

!PoNQ-main/out_hotspot_retrained/
PoNQ-main/out_hotspot_retrained/*
!PoNQ-main/out_hotspot_retrained/HotSpot_pretrained_PoNQ_ABC_retrained_32/
PoNQ-main/out_hotspot_retrained/HotSpot_pretrained_PoNQ_ABC_retrained_32/*
!PoNQ-main/out_hotspot_retrained/HotSpot_pretrained_PoNQ_ABC_retrained_32/metadata.json
!PoNQ-main/out_hotspot_retrained/HotSpot_pretrained_PoNQ_ABC_retrained_32/generation_summary.csv
